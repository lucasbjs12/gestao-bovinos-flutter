NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://gestaobovinos:gestaobovinos@localhost:5433/gestaobovinos?schema=public"
# Banco separado so para `npm test` -- nunca aponte para o mesmo banco do DATABASE_URL
# acima, os testes fazem TRUNCATE nas tabelas entre os arquivos de teste.
DATABASE_URL_TEST="postgresql://gestaobovinos:gestaobovinos@localhost:5433/gestaobovinos_test?schema=public"

JWT_ACCESS_SECRET="troque-por-um-segredo-forte-de-32-bytes"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30

CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Envio do e-mail de "esqueci minha senha" via Resend (resend.com). Sem essa
# chave o endpoint POST /auth/esqueci-senha responde 503. RESEND_FROM_EMAIL
# so precisa mudar quando voce verificar um dominio proprio na Resend -- o
# padrao onboarding@resend.dev funciona sem verificacao, mas so entrega para
# o e-mail da conta Resend usada (util em dev/teste).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Mesma conta Cloudinary que o app Flutter ja usa (cloud name "duseg2d1m" no
# cloudinary_service.dart) -- pegue API_KEY/API_SECRET no painel da Cloudinary
# ou nos secrets do Firebase Functions ja configurados (assinarUploadCloudinary).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# So para `npm run migrate:firestore` (script pontual, nao roda no servidor).
# Baixe a chave de service account em: Console Firebase > Configuracoes do
# projeto > Contas de servico > Gerar nova chave privada. NUNCA commitar esse
# arquivo (o .gitignore ja bloqueia *serviceAccount*.json).
FIREBASE_SERVICE_ACCOUNT_PATH=""
